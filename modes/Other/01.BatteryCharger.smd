Name = Battery/Charger

EnableBoard = true ; powerConsumption_float, batTimeEstimateInMinutes_int, SOC_temperature_float, PCB_temperature_float, skin_temperaturemiliC_int, Rotation_Duty_float, actualFullBatCapacity_float, designedFullBatCapacity_float, temperature_celcius_float, battery_charge_percentage_float, battery_age_percentage_float, batVoltageAvg_float, batCurrentAvg_float, isBatteryFiltered, ChargerConnected_int, ChargerVoltageLimit_int, ChargerCurrentLimit_int 
Text1: {"Battery Actual Capacity: %.0f mAh\n", Board_ActualFullBatteryCapacity_float}
Text2: {"Battery Designed Capacity: %.0f mAh\n", Board_DesignedFullBatteryCapacity_float}
Text3: {"Battery Temperature: %.1f°C\n", Board_BatteryTemperatureCelcius_float}
Text4: {"Battery Raw Charge: %.1f%%\n", Board_BatteryChargePercentage_float}
Text5: {"Battery Age: %.1f%%\n", Board_BatteryAgePercentage_float}
Text6: {"Battery Voltage (%ds AVG): %.0f mV\n", Board_IsBatteryFiltered ? 45 : 5, Board_BatteryVoltageAvg_float}
Text7: {"Battery Current Flow (%ss AVG): %+.0f mA\n", Board_IsBatteryFiltered ? "11.25" : "5", Board_BatteryCurrentAvg_float}
Text8: {"Battery Power Flow%s: %+.3f W\n", Board_IsBatteryFiltered ? "" : " (5s AVG)", Board_PowerConsumption_float}
Text9: {"Battery Remaining Time: %s\n", Board_BatteryTimeEstimateInMinutes_int >= 0 ? {"%d:%02d", Board_BatteryTimeEstimateInMinutes_int / 60, Board_BatteryTimeEstimateInMinutes_int % 60} : "-:--"}
Text10: {"Charger Type: %u\n", Board_ChargerConnected_int}
Text11: {"Charger Max Voltage: %u mV\n", Board_ChargerVoltageLimit_int}
Text12: {"Charger Max Current: %u mA\n", Board_ChargerCurrentLimit_int}

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
Start:
VAR{Text, Text1 + Text2 + Text3 + Text4 + Text5 + Text6 + Text7 + Text8 + Text9}
#if $Board_ChargerConnected_int
	VAR{Text, Text + Text10 + Text11 + Text12}
#endif
TEXT{0, 120, 20, 0xFFFF, "Battery/Charger Stats:"}
TEXT{0, 155, 18, 0xFFFF, Text}